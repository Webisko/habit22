---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header';
import CartDrawer from '../components/CartDrawer';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import ToastContainer from '../components/ToastContainer';
import CookieBanner from '../components/CookieBanner';
import { getAlternatePath } from '../i18n/utils';
import '../index.css';

interface Props {
  title?: string;
  lang?: string;
  alternateUrl?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title = 'Habit22',
  lang = 'pl',
  alternateUrl,
  description,
  ogImage,
  ogType = 'website'
} = Astro.props;

const defaultDesc = lang === 'pl'
  ? 'Habit22 — wyjątkowe torby i akcesoria projektowe dla dziewiarek i pasjonatów rękodzieła. Odkryj naszą kolekcję premium stworzoną z naturalnego lnu.'
  : 'Habit22 — unique project bags and accessories for knitters and craft enthusiasts. Discover our premium collection crafted from natural linen.';

const metaDesc = description || defaultDesc;
const metaImage = ogImage || new URL(`${import.meta.env.BASE_URL || '/habit22/'}produkt__1-1.webp`, Astro.url.origin).href;

// Calculate alternate URL automatically if not explicitly provided
let calculatedAlternateUrl = alternateUrl;
if (!calculatedAlternateUrl) {
  const alternatePath = getAlternatePath(Astro.url.pathname, lang);
  calculatedAlternateUrl = new URL(alternatePath, Astro.url.origin).href;
}

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/en' || Astro.url.pathname === '/en/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.8em' font-size='60' fill='%232C2119' font-family='serif' font-weight='500'>H22</text></svg>">
    <title>{title}</title>
    
    <meta name="description" content={metaDesc} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={metaImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={metaDesc} />
    <meta property="twitter:image" content={metaImage} />
    
    <link rel="alternate" hreflang={lang === 'pl' ? 'en' : 'pl'} href={calculatedAlternateUrl} />
    <link rel="alternate" hreflang={lang} href={Astro.url.href} />
    <ClientRouter />

    {isHomePage && (
      <>
        <script type="application/ld+json" is:inline define:vars={{
          name: "Habit22",
          url: Astro.url.origin,
          logo: metaImage,
          description: defaultDesc
        }}>
          {JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": name,
            "url": url,
            "logo": logo,
            "description": description
          })}
        </script>
        <script type="application/ld+json" is:inline define:vars={{
          name: "Habit22",
          url: Astro.url.origin,
          description: defaultDesc
        }}>
          {JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": name,
            "url": url,
            "description": description
          })}
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen bg-[#FAF7F2] text-[#2C2119] selection:bg-[#E6DCC9] font-sans relative flex flex-col">
    {/* Background Grain Noise */}
    <div
      class="fixed inset-0 z-0 pointer-events-none opacity-[0.02]"
      style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;);"
    >
    </div>
    {/* Header Navigation Island */}
    <Header client:load transition:persist lang={lang} />

    {/* Cart Drawer Island */}
    <CartDrawer client:load transition:persist lang={lang} />
    {/* Main Page Content */}
    <div class="flex-grow flex flex-col relative z-10">
      <slot />
    </div>

    {/* Footer */}
    <Footer lang={lang} />

    {/* Back to Top Button */}
    <BackToTop lang={lang} />

    {/* Toast Notifications */}
    <ToastContainer client:load transition:persist lang={lang} />

    {/* Cookie Consent Banner */}
    <CookieBanner client:load lang={lang} />

    <script>
      function setupIntersectionObserver() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.05,
          rootMargin: '0px 0px -20px 0px'
        });

        document.querySelectorAll('.reveal').forEach(el => {
          observer.observe(el);
        });
      }

      function scrollToHash() {
        if (window.location.hash) {
          const id = window.location.hash.substring(1);
          const el = document.getElementById(id);
          if (el) {
            setTimeout(() => {
              el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
          } else {
            // Retry after a brief delay for hydration / React mount
            setTimeout(() => {
              const elRetry = document.getElementById(id);
              if (elRetry) {
                elRetry.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }, 300);
          }
        }
      }

      function setupDragToScroll() {
        const sliders = document.querySelectorAll('.drag-to-scroll');
        sliders.forEach((slider) => {
          if (slider instanceof HTMLElement) {
            if (slider.dataset.dragInitialized) return;
            slider.dataset.dragInitialized = 'true';

            let isDown = false;
            let startX = 0;
            let scrollLeft = 0;

            slider.addEventListener('dragstart', (e) => {
              e.preventDefault();
            });

            slider.addEventListener('mousedown', (e) => {
              if (!(e instanceof MouseEvent)) return;
              isDown = true;
              slider.style.cursor = 'grabbing';
              startX = e.pageX - slider.offsetLeft;
              scrollLeft = slider.scrollLeft;
              slider.dataset.startXVal = String(e.pageX);
              slider.style.scrollBehavior = 'auto';
              slider.style.scrollSnapType = 'none';
            });

            slider.addEventListener('mouseleave', () => {
              if (!isDown) return;
              isDown = false;
              slider.style.cursor = '';
              slider.style.scrollBehavior = '';
              slider.style.scrollSnapType = '';
              slider.removeAttribute('data-is-dragging');
            });

            slider.addEventListener('mouseup', () => {
              if (!isDown) return;
              isDown = false;
              slider.style.cursor = '';
              slider.style.scrollBehavior = '';
              slider.style.scrollSnapType = '';
              setTimeout(() => {
                slider.removeAttribute('data-is-dragging');
              }, 50);
            });

            slider.addEventListener('mousemove', (e) => {
              if (!isDown || !(e instanceof MouseEvent)) return;
              e.preventDefault();
              const x = e.pageX - slider.offsetLeft;
              const walk = (x - startX) * 1.5;
              slider.scrollLeft = scrollLeft - walk;
              
              const startXVal = parseFloat(slider.dataset.startXVal || '0');
              const dist = Math.abs(e.pageX - startXVal);
              if (dist > 5) {
                slider.setAttribute('data-is-dragging', 'true');
              }
            });

            slider.addEventListener('click', (e) => {
              if (slider.getAttribute('data-is-dragging') === 'true') {
                e.preventDefault();
                e.stopPropagation();
              }
            }, true);
          }
        });
      }

      // Initial execution
      setupIntersectionObserver();
      scrollToHash();
      setupDragToScroll();
      
      // Re-run observer setup on View Transitions page swap
      document.addEventListener('astro:after-swap', () => {
        setupIntersectionObserver();
        scrollToHash();
        setupDragToScroll();
      });
    </script>
  </body>
</html>
