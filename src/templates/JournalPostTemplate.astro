---
import Layout from '../layouts/Layout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { TRANSLATIONS } from '../i18n/translations';
import type { JournalPost } from '../i18n/translations';

interface Props {
  post: JournalPost;
  otherPosts: JournalPost[];
  lang: string;
}

const { post, otherPosts, lang } = Astro.props;
const { t, l } = useTranslations(lang);

const altLang = lang === 'pl' ? 'en' : 'pl';
const altPosts = TRANSLATIONS[altLang].journal_posts;
const altPost = altPosts.find((p) => p.id === post.id)!;
const alternateUrl = getLocalizedPath(`journal/${altPost.slug}`, altLang);
---

<Layout title={`${post.title} - Habit22`} lang={lang} alternateUrl={alternateUrl} description={post.excerpt}>
  <main class="flex-grow w-full min-h-screen pt-32 md:pt-40 lg:pt-44 pb-24 px-6 md:px-12 max-w-[800px] mx-auto flex flex-col relative z-10">
    <article class="w-full flex flex-col animate-fade-in-up">
      <a
        href={l('journal')}
        class="self-start flex items-center space-x-2 text-sm uppercase tracking-widest text-[#8C7C6D] hover:text-[#2C2119] transition-colors mb-12"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>{t.back_to_journal}</span>
      </a>

      <header class="mb-12 md:mb-16">
        <h1 class="text-2xl md:text-4xl font-serif text-[#2C2119] tracking-wider uppercase text-left leading-[1.2]">
          {post.title}
        </h1>
      </header>

      <div class="w-full aspect-[4/3] md:aspect-[16/9] overflow-hidden bg-[#EBE2D3] mb-12 md:mb-16">
        <img
          src={`${import.meta.env.BASE_URL}wpis-${post.id}.webp`}
          alt={post.title}
          class="w-full h-full object-cover mix-blend-multiply opacity-90 grayscale-[10%]"
          width="800"
          height="450"
          fetchpriority="high"
        />
      </div>

      <div class="flex flex-col space-y-8 text-lg md:text-xl text-[#5C4E43] font-serif leading-relaxed max-w-3xl mx-auto">
        <p class="font-medium text-[#2C2119] text-xl md:text-2xl mb-4">
          {post.excerpt}
        </p>
        {post.content.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      {/* Other posts section */}
      <div class="mt-24 md:mt-32 pt-16 border-t border-[#E6DCC9] w-full">
        <h2 class="text-xl md:text-2xl font-serif text-[#2C2119] mb-12 text-center uppercase tracking-widest">
          {lang === "pl" ? "Pozostałe wpisy" : "Other posts"}
        </h2>
        <div class="relative group/journal select-none">
          <div class="drag-to-scroll flex lg:grid lg:grid-cols-3 gap-6 md:gap-8 overflow-x-auto hide-scrollbar snap-x snap-mandatory lg:snap-none scroll-smooth pb-4 relative">
            {otherPosts.map((otherPost, index) => (
              <article class="group cursor-pointer flex flex-col h-full flex-shrink-0 w-[76%] sm:w-[41%] lg:w-full snap-start reveal" style={`transition-delay: ${index * 100}ms;`}>
                <a href={l(`journal/${otherPost.slug}`)} class="flex flex-col h-full">
                  <div class="aspect-[4/3] w-full overflow-hidden mb-6 bg-[#EBE2D3] relative">
                    <img
                      src={`${import.meta.env.BASE_URL}wpis-${otherPost.id}.webp`}
                      alt={otherPost.title}
                      class="w-full h-full object-cover mix-blend-multiply opacity-80 transition-all duration-700 ease-out grayscale-[10%] group-hover:scale-105 group-hover:opacity-100"
                      width="400"
                      height="300"
                      loading="lazy"
                    />
                  </div>
                  <h3 class="text-lg md:text-xl font-serif text-[#2C2119] mb-4 group-hover:text-[#8C7C6D] transition-colors">
                    {otherPost.title}
                  </h3>
                  <p class="text-[#5C4E43] font-serif pr-4 leading-relaxed line-clamp-2 text-sm">
                    {otherPost.excerpt}
                  </p>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>
