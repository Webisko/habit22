---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t, l } = useTranslations(lang);
---

<Layout title={`${t.shop} - Habit22`} lang={lang}>
  <main class="flex-grow w-full min-h-screen pt-32 md:pt-40 lg:pt-44 pb-24 px-6 md:px-12 max-w-[1440px] mx-auto flex flex-col relative z-10">
    <div class="flex flex-col items-center mb-16 md:mb-24 text-center animate-fade-in-up">
      <h1 class="text-3xl md:text-5xl font-serif text-[#2C2119] tracking-wider uppercase mb-6">
        {t.shop}
      </h1>
      <p class="text-[#5C4E43] max-w-2xl text-base md:text-lg font-serif mb-12 leading-relaxed">
        {lang === "pl"
          ? "Odkryj naszą kolekcję ręcznie szytych toreb dziewiarskich. Każda z nich została starannie zaprojektowana i wykonana z myślą o miłośniczkach rzemiosła, ceniących funkcjonalność i ponadczasowy styl."
          : "Discover our collection of hand-sewn knitting bags. Each piece is carefully designed and crafted for craft enthusiasts, valuing functionality and timeless style."}
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-8 md:gap-12 lg:gap-16 w-full max-w-7xl mx-auto">
      {PRODUCTS.map((prod, index) => (
        <div
          class="group flex flex-col cursor-pointer h-full w-full md:w-[calc((100%-3rem)/2)] lg:w-[calc((100%-8rem)/3)] animate-fade-in-up-heavy"
          style={`animation-delay: ${index * 100}ms;`}
        >
          <a href={l(`product/${prod.id}`)} class="flex flex-col h-full">
            <div class="w-full aspect-square mb-6 overflow-hidden relative bg-[#FAF7F2]">
              <img
                src={prod.images[0]}
                alt={prod.design[lang === 'pl' ? 'pl' : 'en']}
                class="w-full h-full object-cover opacity-90 transition-transform duration-700 ease-out group-hover:scale-105"
              />
            </div>
            <h3 class="text-xl font-serif text-[#2C2119] mb-2 group-hover:text-[#8C7C6D] transition-colors">
              {prod.design[lang === 'pl' ? 'pl' : 'en']}
            </h3>
            <p class="text-[#8C7C6D] mb-5 font-normal tracking-wide">
              {prod.title[lang === 'pl' ? 'pl' : 'en']}
            </p>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-[#E6DCC9] mb-6">
              <span class="text-[#2C2119] font-serif text-lg">
                {t.product_price}
              </span>
            </div>
            <div
              class="w-full border border-[#2C2119] text-[#2C2119] py-3 text-sm font-normal uppercase tracking-[0.2em] hover:bg-[#2C2119] hover:text-white transition-colors flex items-center justify-center space-x-2 relative overflow-hidden group/cartbtn"
            >
              <span class="relative z-20">{t.product_details}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover/cartbtn:opacity-100 transition-all duration-300 -ml-6 group-hover/cartbtn:ml-0 relative z-20"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </a>
        </div>
      ))}
    </div>
  </main>
</Layout>
