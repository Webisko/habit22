---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t, l } = useTranslations(lang);
---

<Layout title={`${t.journal} - Habit22`} lang={lang}>
  <main class="flex-grow w-full min-h-screen pt-32 md:pt-48 lg:pt-28 pb-24 px-6 md:px-12 max-w-[1440px] mx-auto flex flex-col relative z-10 animate-fade-in-up">
    <div class="w-full flex flex-col">
      <h1 class="text-3xl md:text-5xl font-serif text-[#2C2119] tracking-wider uppercase mb-16 md:mb-24 text-center">
        {t.journal_section_title}
      </h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 md:gap-16">
        {t.journal_posts.map((post, index) => (
          <article class="flex flex-col group cursor-pointer reveal" style={`transition-delay: ${index * 100}ms;`}>
            <a href={l(`journal/${post.id}`)} class="flex flex-col h-full">
              <div class="w-full aspect-[4/3] overflow-hidden bg-[#EBE2D3] mb-6 relative">
                <img
                  src={`${import.meta.env.BASE_URL}wpis-${post.id}.webp`}
                  alt={post.title}
                  class="w-full h-full object-cover mix-blend-multiply opacity-80 transition-all duration-700 ease-out grayscale-[10%] group-hover:scale-105 group-hover:opacity-100"
                />
              </div>
              <h3 class="text-xl md:text-2xl font-serif text-[#2C2119] mb-4 group-hover:text-[#8C7C6D] transition-colors">
                {post.title}
              </h3>
              <p class="text-[#5C4E43] font-serif pr-4 leading-relaxed line-clamp-3">
                {post.excerpt}
              </p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>
