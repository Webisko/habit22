---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t, l } = useTranslations(lang);
---

<Layout title={`${t.journal} - Habit22`} lang={lang}>
  <main class="flex-grow w-full min-h-screen pt-32 md:pt-40 lg:pt-44 pb-24 px-6 md:px-12 max-w-[1440px] mx-auto flex flex-col relative z-10 animate-fade-in-up">
    <div class="w-full flex flex-col">
      <h1 class="text-3xl md:text-5xl font-serif text-[#2C2119] tracking-wider uppercase mb-16 md:mb-24 text-center">
        {t.journal_section_title}
      </h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-12 md:gap-y-16 gap-x-12 xl:gap-x-16">
        {t.journal_posts.map((post, index) => {
          let hideClass = '';
          if (index >= 12) {
            hideClass = 'hidden-all';
          } else if (index >= 6) {
            hideClass = 'hidden-mobile';
          }
          
          return (
            <article 
              class={`flex flex-col group cursor-pointer reveal ${hideClass}`} 
              style={`transition-delay: ${(index % 6) * 100}ms;`}
              data-post-index={index}
            >
              <a href={l(`journal/${post.slug}`)} class="flex flex-col h-full">
                <div class="w-full aspect-[4/3] overflow-hidden bg-[#EBE2D3] mb-6 relative">
                  <img
                    src={`${import.meta.env.BASE_URL}wpis-${post.id}.webp`}
                    alt={post.title}
                    class="w-full h-full object-cover mix-blend-multiply opacity-80 transition-all duration-700 ease-out grayscale-[10%] group-hover:scale-105 group-hover:opacity-100"
                  />
                </div>
                <h3 class="text-xl md:text-2xl font-serif text-[#2C2119] mb-4 group-hover:text-[#8C7C6D] transition-colors">
                  {post.title}
                </h3>
                <p class="text-[#5C4E43] font-serif pr-4 leading-relaxed line-clamp-3">
                  {post.excerpt}
                </p>
              </a>
            </article>
          );
        })}
      </div>

      {t.journal_posts.length > 6 && (
        <div class={`w-full flex justify-center mt-16 md:mt-24 ${t.journal_posts.length <= 12 ? 'md:hidden' : ''}`}>
          <button
            id="show-more-btn"
            class="bg-[#2C2119] text-[#F3EDE3] py-5 px-8 w-full md:w-80 text-sm font-sans font-medium uppercase tracking-[0.2em] hover:bg-[#1A140F] transition-colors flex items-center justify-center space-x-3 group relative overflow-hidden text-center cursor-pointer"
          >
            <span class="relative z-20">
              {t.show_more}
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-hover:opacity-100 transition-all duration-300 -ml-8 group-hover:ml-0 relative z-20">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span class="absolute inset-0 z-10 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-[150%] group-hover:translate-x-[150%] transition-transform duration-700 ease-in-out"></span>
          </button>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  @media (max-width: 767px) {
    .hidden-mobile {
      display: none !important;
    }
  }
  .hidden-all {
    display: none !important;
  }
</style>

<script>
  function setupShowMore() {
    const showMoreBtn = document.getElementById('show-more-btn');
    if (!showMoreBtn) return;

    showMoreBtn.parentElement?.classList.remove('hidden');

    showMoreBtn.addEventListener('click', () => {
      const isMobile = window.innerWidth < 768;
      const selector = isMobile ? '.hidden-mobile, .hidden-all' : '.hidden-all';
      const hiddenPosts = Array.from(document.querySelectorAll(selector));
      
      const batchSize = isMobile ? 6 : 12;
      const nextBatch = hiddenPosts.slice(0, batchSize);
      
      nextBatch.forEach((post) => {
        post.classList.remove('hidden-mobile');
        post.classList.remove('hidden-all');
        requestAnimationFrame(() => {
          post.classList.add('active');
        });
      });

      const remainingHidden = document.querySelectorAll(selector);
      if (remainingHidden.length === 0) {
        showMoreBtn.parentElement?.classList.add('hidden');
      }
    });
  }

  setupShowMore();
  document.addEventListener('astro:after-swap', setupShowMore);
</script>
