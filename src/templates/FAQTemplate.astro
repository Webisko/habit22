---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
---

<Layout title={`${t.faq} - Habit22`} lang={lang}>
  <main class="flex-grow w-full min-h-screen pt-32 md:pt-48 lg:pt-28 pb-24 px-6 md:px-12 max-w-[800px] mx-auto flex flex-col relative z-10 animate-fade-in-up">
    <div class="flex flex-col mb-16">
      <h1 class="text-3xl md:text-5xl font-serif text-[#2C2119] tracking-wider uppercase mb-16">
        {t.faq_title}
      </h1>

      <div class="flex flex-col space-y-16">
        {t.faq_page_content.map((section) => (
          <div class="flex flex-col">
            <h2 class="text-3xl font-serif font-bold text-[#2C2119] mb-8 uppercase tracking-wider">
              {section.title}
            </h2>
            <div class="flex flex-col space-y-8">
              {section.items.map((item) => (
                <div class="flex flex-col border-b border-[#E6DCC9] pb-6 last:border-b-0 last:pb-0">
                  <h3 class="text-xl font-serif text-[#2C2119] mb-4">
                    {item.q}
                  </h3>
                  <p class="text-[#5C4E43] leading-relaxed font-serif">
                    {item.a}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>
