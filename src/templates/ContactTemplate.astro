---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t, l } = useTranslations(lang);
---

<Layout title={t.meta_title_contact} lang={lang} description={t.meta_desc_contact}>
  <main class="flex-grow w-full min-h-screen pt-32 md:pt-40 lg:pt-44 pb-24 px-6 md:px-12 xl:px-16 max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8 lg:gap-12 xl:gap-16 items-stretch relative z-10">
    <div class="hidden md:block w-full h-[60vh] md:h-auto overflow-hidden bg-[#EBE2D3] relative animate-fade-in-scale">
      <img
        src={`${import.meta.env.BASE_URL}produkt__2-2.webp`}
        class="absolute inset-0 w-full h-full object-cover mix-blend-multiply opacity-90"
        alt="Habit22 Contact"
        width="640"
        height="850"
        loading="lazy"
      />
    </div>
    <div class="w-full flex flex-col pt-0 animate-fade-in-up" style="animation-delay: 200ms;">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-serif text-[#2C2119] tracking-wider uppercase mb-12 leading-none -mt-1 md:-mt-2">
          {t.contact_title}
        </h1>

        <form
          class="flex flex-col space-y-6 md:space-y-8 w-full max-w-none md:max-w-md mb-12 md:mb-20"
          id="contact-form"
          data-lang={lang}
        >
          {/* Honeypot field for bot protection */}
          <div class="hidden" aria-hidden="true" style="display: none;">
            <label for="contact-hp">Website</label>
            <input type="text" id="contact-hp" name="hp_name" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex flex-col">
            <label for="contact-name" class="text-sm uppercase tracking-widest text-[#8C7C6D] mb-2">
              {t.contact_name}
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              class="bg-transparent border-b border-[#E6DCC9] py-2 focus:outline-none focus:border-[#2C2119] text-[#2C2119] transition-colors font-serif"
            />
          </div>
          <div class="flex flex-col">
            <label for="contact-email" class="text-sm uppercase tracking-widest text-[#8C7C6D] mb-2">
              {t.contact_email}
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="bg-transparent border-b border-[#E6DCC9] py-2 focus:outline-none focus:border-[#2C2119] text-[#2C2119] transition-colors font-serif"
            />
          </div>
          <div class="flex flex-col pb-6">
            <label for="contact-message" class="text-sm uppercase tracking-widest text-[#8C7C6D] mb-2">
              {t.contact_message}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              class="bg-transparent border-b border-[#E6DCC9] py-2 focus:outline-none focus:border-[#2C2119] text-[#2C2119] resize-none transition-colors font-serif"
            ></textarea>
          </div>
          <p class="text-sm text-[#8C7C6D] mb-6 leading-relaxed">
            {t.contact_consent}
            <a
              href={l('privacy')}
              class="underline hover:text-[#2C2119] transition-colors"
            >
              {t.privacy.toLowerCase()}
            </a>
            .
          </p>
          <button type="submit" id="contact-submit-btn" class="self-start text-sm font-semibold tracking-widest uppercase border-b border-[#2C2119] pb-1 hover:text-[#8C7C6D] hover:border-[#8C7C6D] transition-colors">
            {t.contact_send}
          </button>
        </form>
      </div>

      <div class="mt-auto pt-8 border-t border-[#E6DCC9] w-full max-w-none md:max-w-md">
        <p class="text-sm uppercase tracking-widest text-[#8C7C6D] mb-4">
          SOCIAL MEDIA
        </p>
        <div class="flex space-x-6 text-[#2C2119] leading-none mb-0 pb-0 md:-mb-1">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#8C7C6D] transition-colors text-base font-serif block"
          >
            Instagram
          </a>
          <a
            href="https://pinterest.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#8C7C6D] transition-colors text-base font-serif block"
          >
            Pinterest
          </a>
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[#8C7C6D] transition-colors text-base font-serif block"
          >
            Facebook
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { showToast } from '../stores/toast';
  import { TRANSLATIONS } from '../i18n/translations';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const lang = (form.getAttribute('data-lang') || 'pl') as 'pl' | 'en';
    const originalBtnText = submitBtn?.innerText || '';

    const nameInput = form.querySelector('input[name="name"]') as HTMLInputElement;
    const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;
    const messageInput = form.querySelector('textarea[name="message"]') as HTMLTextAreaElement;
    const hpInput = form.querySelector('input[name="hp_name"]') as HTMLInputElement;

    const payload = {
      name: nameInput?.value?.trim() || '',
      email: emailInput?.value?.trim() || '',
      message: messageInput?.value?.trim() || '',
      hp_name: hpInput?.value || '',
    };

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = lang === 'pl' ? 'Wysyłanie...' : 'Sending...';
    }

    try {
      const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8000/api';
      const res = await fetch(`${apiUrl}/inquiries`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        const message = TRANSLATIONS[lang].contact_success_toast;
        showToast(message, 'success');
        form.reset();
      } else {
        const errData = await res.json().catch(() => null);
        const errMsg = errData?.message || (lang === 'pl' ? 'Wystąpił błąd podczas wysyłania formularza.' : 'Error sending form.');
        showToast(errMsg, 'error');
      }
    } catch (err) {
      console.error('Contact form submission error:', err);
      showToast(lang === 'pl' ? 'Problem z połączeniem. Spróbuj ponownie później.' : 'Connection problem. Please try again.', 'error');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = originalBtnText;
      }
    }
  });
</script>
