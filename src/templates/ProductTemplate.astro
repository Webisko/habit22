---
import Layout from '../layouts/Layout.astro';
import ProductSelector from '../components/ProductSelector';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  lang: string;
}

const { product, lang } = Astro.props;
const { t, l } = useTranslations(lang);

const altLang = lang === 'pl' ? 'en' : 'pl';
const alternateUrl = getLocalizedPath(`product/${product.slugs[altLang]}`, altLang);
---

<Layout title={`${product.title[lang === 'pl' ? 'pl' : 'en']} - Habit22`} lang={lang} alternateUrl={alternateUrl}>
  <main class="flex-grow pt-24 md:pt-32 lg:pt-36 pb-24 px-6 md:px-12 w-full max-w-[1440px] mx-auto relative z-10">
    
    {/* Breadcrumbs / Back button */}
    <div class="mb-10">
      <a
        href={l('shop')}
        class="inline-flex items-center space-x-2 text-sm uppercase tracking-widest text-[#8C7C6D] hover:text-[#2C2119] transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>{t.back_to_shop}</span>
      </a>
    </div>

    {/* Product Customizer React Island */}
    <ProductSelector client:load product={product} lang={lang} />

    {/* Product details and FAQ - Server Rendered */}
    <div class="w-full border-t border-[#E6DCC9] pt-12">
      <div class="grid grid-cols-1 lg:grid-cols-[1.618fr_1fr] gap-12 lg:gap-24 mb-16">
        <div class="w-full min-w-0">
          <h2 class="text-2xl md:text-3xl font-serif text-[#2C2119] mb-8">
            {lang === "pl" ? "Opis produktu" : "Product Description"}
          </h2>
          <p class="text-[#5C4E43] font-serif leading-relaxed text-lg whitespace-pre-line">
            {t.product_long_desc(product.design[lang === 'pl' ? 'pl' : 'en'])}
          </p>
        </div>
        <div class="w-full flex flex-col pt-0 lg:pt-[68px] min-w-0">
          <div class="text-[#5C4E43] font-serif leading-relaxed text-lg flex flex-col md:flex-row lg:flex-col gap-8 md:gap-16 lg:gap-8">
            <div class="flex-1">
              <strong class="block text-xl font-bold mb-2 text-[#2C2119]">
                {t.product_dimensions_title}
              </strong>
              <div class="whitespace-pre-line">
                {t.product_dimensions}
              </div>
            </div>
            <div class="flex-1">
              <strong class="block text-xl font-bold mb-2 text-[#2C2119]">
                {t.product_materials_title}
              </strong>
              <div class="whitespace-pre-line">
                {t.product_materials}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="w-full border-t border-[#E6DCC9] pt-12">
        <h2 class="text-2xl md:text-3xl font-serif text-[#2C2119] mb-8">
          {t.faq_title}
        </h2>
        <div class="flex flex-col lg:flex-row lg:space-y-0 lg:flex-wrap gap-y-12">
          {t.faq_items.map((item) => (
            <div class="w-full lg:w-1/2 pr-8 lg:pr-16 relative">
              <h4 class="text-xl font-serif text-[#2C2119] mb-4 pr-8">
                {item.q}
              </h4>
              <p class="text-[#5C4E43] font-serif leading-relaxed opacity-90">
                {item.a}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>
</Layout>
