---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t, l } = useTranslations(lang);
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-40 bg-[#FAF7F2] border-t border-[#E6DCC9] shadow-[0_-8px_30px_rgb(44,33,25,0.04)] px-6 py-6 md:py-8 transition-transform duration-500 ease-out transform translate-y-full pointer-events-none hidden"
>
  <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <p class="text-sm text-[#5C4E43] font-serif leading-relaxed text-center md:text-left max-w-3xl">
      {t.cookie_consent_text}{' '}
      <a
        href={l('privacy')}
        class="underline hover:text-[#2C2119] transition-colors"
      >
        {t.privacy.toLowerCase()}
      </a>
      .
    </p>
    <div class="flex items-center space-x-4 w-full md:w-auto shrink-0 justify-center">
      <button
        id="cookie-decline"
        type="button"
        class="border border-[#2C2119] text-[#2C2119] py-3 px-6 text-xs font-semibold uppercase tracking-widest hover:bg-[#2C2119] hover:text-[#F3EDE3] transition-colors shrink-0 cursor-pointer"
      >
        {t.cookie_decline}
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="border border-[#2C2119] bg-[#2C2119] text-[#F3EDE3] py-3 px-6 text-xs font-semibold uppercase tracking-widest hover:bg-[#1A140F] hover:border-[#1A140F] transition-colors shrink-0 cursor-pointer"
      >
        {t.cookie_accept}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function initCookieBanner() {
      const banner = document.getElementById('cookie-banner');
      if (!banner) return;
      
      try {
        if (localStorage.getItem('habit22_cookie_consent')) {
          return;
        }
      } catch (e) {}

      let shown = false;
      const showBanner = () => {
        if (shown) return;
        shown = true;
        window.removeEventListener('scroll', showBanner);
        window.removeEventListener('pointerdown', showBanner);
        window.removeEventListener('keydown', showBanner);

        banner.classList.remove('hidden');
        requestAnimationFrame(() => {
          banner.classList.remove('translate-y-full', 'pointer-events-none');
        });
      };

      // Show on first user interaction
      window.addEventListener('scroll', showBanner, { passive: true, once: true });
      window.addEventListener('pointerdown', showBanner, { passive: true, once: true });
      window.addEventListener('keydown', showBanner, { passive: true, once: true });

      // Fallback timer
      setTimeout(showBanner, 4000);

      const acceptBtn = document.getElementById('cookie-accept');
      const declineBtn = document.getElementById('cookie-decline');

      const hideBanner = (status) => {
        try {
          localStorage.setItem('habit22_cookie_consent', status);
          const apiUrl = (typeof window !== 'undefined' && window.__PUBLIC_API_URL) || '/api';
          fetch(`${apiUrl}/cookie-consents`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              consent_analytics: status === 'accepted',
              consent_marketing: status === 'accepted',
            }),
          }).catch(() => {});
        } catch (e) {}
        banner.classList.add('translate-y-full', 'pointer-events-none');
        setTimeout(() => {
          banner.classList.add('hidden');
        }, 500);
      };

      if (acceptBtn) {
        acceptBtn.onclick = () => hideBanner('accepted');
      }
      if (declineBtn) {
        declineBtn.onclick = () => hideBanner('declined');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieBanner);
    } else {
      initCookieBanner();
    }
    document.addEventListener('astro:after-swap', initCookieBanner);
  })();
</script>
