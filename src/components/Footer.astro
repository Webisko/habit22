---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t, l } = useTranslations(lang);
---

<footer class="w-full py-16 md:py-24 px-6 md:px-12 bg-[#2C2119] font-sans text-[#E6DCC9] text-sm uppercase tracking-widest relative z-10">
  <div class="max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-12">
    <div class="col-span-1 md:col-span-2">
      <h3 class="text-xl font-serif text-[#F3EDE3] mb-6 uppercase">
        Habit22
      </h3>
      <p class="max-w-xs leading-loose mb-8 normal-case font-serif tracking-normal text-base text-[#CBBFA8]">
        {t.footer_p1}
      </p>
    </div>

    <div>
      <h4 class="mb-6 font-semibold text-[#F3EDE3]">{t.explore}</h4>
      <ul class="space-y-4 text-[#CBBFA8]">
        <li>
          <a href={l('shop')} class="hover:text-white transition-colors">
            {t.shop}
          </a>
        </li>
        <li>
          <a href={l('about')} class="hover:text-white transition-colors">
            {t.about}
          </a>
        </li>
        <li>
          <a href={l('journal')} class="hover:text-white transition-colors">
            {t.journal}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="mb-6 font-semibold text-[#F3EDE3]">{t.shortcuts}</h4>
      <ul class="space-y-4 text-[#CBBFA8]">
        <li>
          <a href={l('contact')} class="hover:text-white transition-colors">
            {t.contact}
          </a>
        </li>
        <li>
          <a href={l('faq')} class="hover:text-white transition-colors">
            {t.faq}
          </a>
        </li>
        <li>
          <a href={l('terms')} class="hover:text-white transition-colors">
            {t.terms}
          </a>
        </li>
        <li>
          <a href={l('privacy')} class="hover:text-white transition-colors">
            {t.privacy}
          </a>
        </li>
        <li>
          <a href={l('cookies')} class="hover:text-white transition-colors">
            {t.cookies}
          </a>
        </li>
        <li>
          <a href="mailto:habitworld22@gmail.com" class="hover:text-white transition-colors normal-case tracking-normal mt-2 inline-block">
            habitworld22@gmail.com
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-[1440px] mx-auto mt-24 pt-8 border-t border-[#3A2D23] flex flex-col md:flex-row justify-between items-center text-sm text-[#CBBFA8]">
    <div class="flex flex-col md:flex-row items-center gap-2 md:gap-8 text-center md:text-left">
      <p>
        &copy; {new Date().getFullYear()} Habit22 . {t.all_rights_reserved}
      </p>
      <p class="normal-case">
        {t.developed_by}{" "}
        <a
          href="https://webisko.pl"
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-white transition-colors"
        >
          Webisko.pl
        </a>
      </p>
    </div>
  </div>
</footer>
